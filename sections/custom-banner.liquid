<link rel="stylesheet" href="{{ 'custom-banner.css' | asset_url }}">

<div class="custom-banner">
  <!-- Top Bar -->
  <div class="banner-topbar">
    <span class="logo_text">{{ section.settings.logo_text }}</span>
    <span class="topbar-text">{{ section.settings.topbar_text }}</span>
    <a class="choose-gift-btn" href="{{ section.settings.choose_gift_link }}">
      {{ section.settings.choose_gift_text }}
    </a>
  </div>

  <!-- Banner Main -->
  <div class="banner-main">
    <div class="banner-vectors">
      {% if section.settings.vector_frame_1 != blank %}
        <img src="{{ section.settings.vector_frame_1 | image_url: width: 1600 }}" alt="Vector Frame 1" class="vector-frame-1">
      {% endif %}
      {% if section.settings.vector_frame_2 != blank %}
        <img src="{{ section.settings.vector_frame_2 | image_url: width: 1000 }}" alt="Vector Frame 2" class="vector-frame-2">
      {% endif %}
    </div>

    <div class="banner-content">
      <h1>{{ section.settings.banner_title }}</h1>
      <p>{{ section.settings.banner_description }}</p>
      <a href="{{ section.settings.shop_now_link }}" class="shop-now-btn">
        {{ section.settings.shop_now_text }}
      </a>
    </div>
  </div> 

  <!-- Footer -->
  <div class="banner-footer-text">
    {{ section.settings.footer_text }}
  </div>
</div>

{% schema %}
{
  "name": "Custom Banner",
  "settings": [
    { "type": "text", "id": "logo_text", "label": "Logo text", "default": "TISSO VISON" },
    { "type": "text", "id": "topbar_text", "label": "Top Bar Text", "default": "Find the ideal gift for your loved ones" },
    { "type": "text", "id": "choose_gift_text", "label": "Choose Gift Button Text", "default": "CHOOSE GIFT" },
    { "type": "url", "id": "choose_gift_link", "label": "Choose Gift Button Link", "default": "/" },
    { "type": "text", "id": "banner_title", "label": "Banner Title", "default": "The Gift Guide" },
    { "type": "textarea", "id": "banner_description", "label": "Banner Description", "default": "Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season." },
    { "type": "text", "id": "shop_now_text", "label": "Shop Now Button Text", "default": "SHOP NOW" },
    { "type": "url", "id": "shop_now_link", "label": "Shop Now Button Link", "default": "/" },
    { "type": "image_picker", "id": "vector_frame_1", "label": "Vector Frame 1" },
    { "type": "image_picker", "id": "vector_frame_2", "label": "Vector Frame 2" },
    { "type": "text", "id": "footer_text", "label": "Footer Text", "default": "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL" }
  ],
  "presets": [
    { "name": "Custom Banner", "category": "Custom" }
  ]
}
{% endschema %}
